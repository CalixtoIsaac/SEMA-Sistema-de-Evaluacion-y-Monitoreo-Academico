# Copia este archivo como .env y completa los valores.

# Puerto del servidor
PORT=3000

# Clave para firmar las sesiones (mínimo 32 caracteres). Opcional:
# si la dejas vacía, SEMA genera una persistente en data/jwt.secret.
# Para generar una a mano:
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=

# Ruta del archivo de la base de datos (opcional)
# DB_PATH=./data/app.db

{
  "name": "sema",
  "version": "1.0.0",
  "description": "SEMA · Sistema de Evaluación y Monitoreo Académico: seguimiento de calificaciones, faltas y evolución del desempeño estudiantil, con indicadores y alertas para detectar alumnos en riesgo.",
  "private": true,
  "scripts": {
    "start": ".venv\\Scripts\\python.exe -m uvicorn sema.main:app --host 127.0.0.1 --port 3000",
    "dev": ".venv\\Scripts\\python.exe -m uvicorn sema.main:app --reload --host 127.0.0.1 --port 3000",
    "test": "node --test",
    "anonimizar": "node scripts/anonimizar-excel.js",
    "rendimiento:busqueda": "node scripts/rendimiento_busqueda.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "cross-env": "^7.0.3"
  }
}
